    "review.nome_negocio":"Business","review.tipo_negocio":"Type","review.servicos_oferecidos":"Services",
    "review.faq_horario":"Hours","review.faq_area":"Area","review.faq_pagamento":"Payment","review.faq_adicional":"Extra",
    "review.idioma_padrao":"Language","review.timezone":"Time zone","review.contato_nome":"Name","review.contato_responsavel":"Contact"
  }
};
let lang = "pt";

function applyI18n(){
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const key = el.getAttribute("data-i18n");
    const val = I18N[lang][key];
    if (typeof val === "function") return; // handled elsewhere
    if (val !== undefined) el.textContent = val;
  });
  document.querySelectorAll("[data-i18n-ph]").forEach(el=>{
    const key = el.getAttribute("data-i18n-ph");
    const val = I18N[lang][key];
    if (val !== undefined) el.setAttribute("placeholder", val);
  });
  document.getElementById("stepName").textContent = I18N[lang]["step."+currentStep] || "";
  document.querySelector(".progress-label span").innerHTML = I18N[lang]["progress.of"](currentStep);
  document.querySelector(".progress-label .step-name").textContent = I18N[lang]["step."+currentStep] || "";
  updateNavLabels();
  document.title = lang === "pt" ? "Auryx — Cadastro do seu AI Employee" : "Auryx — Sign up your AI Employee";
}

document.querySelectorAll(".langtoggle button").forEach(btn=>{
  btn.addEventListener("click", ()=>{
    document.querySelectorAll(".langtoggle button").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    lang = btn.getAttribute("data-lang");
    applyI18n();
  });
});

/* ---------------- Step logic ---------------- */
const TOTAL_STEPS = 5;
let currentStep = 1;
const steps = document.querySelectorAll(".step[data-step]");
const wingFill = document.getElementById("wingFill");
const btnBack = document.getElementById("btnBack");
const btnNext = document.getElementById("btnNext");
const navRow = document.getElementById("navRow");

function showStep(n){
  steps.forEach(s=> s.classList.toggle("active", s.getAttribute("data-step") == String(n)));
  wingFill.style.width = (n===("success") ? 100 : (n/TOTAL_STEPS)*100) + "%";
  btnBack.style.visibility = (n === 1) ? "hidden" : "visible";
  if (n === "success"){ navRow.style.display = "none"; }
  applyI18n();
}

function updateNavLabels(){
  btnNext.textContent = (currentStep === TOTAL_STEPS) ? I18N[lang]["nav.submit"] : I18N[lang]["nav.next"];
  btnBack.textContent = I18N[lang]["nav.back"];
}

function validateStep(n){
  let ok = true;
  document.querySelectorAll(`.step[data-step="${n}"] .field`).forEach(f=>{
    const input = f.querySelector("input, textarea, select");
    if (!input) return;
    const requiredFields = ["nome_negocio","tipo_negocio","servicos_oferecidos","faq_horario","faq_area","faq_pagamento","contato_nome","contato_responsavel"];
    if (requiredFields.includes(input.name) && !input.value.trim()){
      f.classList.add("invalid"); ok = false;
    } else {
      f.classList.remove("invalid");
    }
  });
  return ok;
}

function buildReview(){
  const data = collectData();
  const list = document.getElementById("reviewList");
  list.innerHTML = "";
  Object.entries(data).forEach(([k,v])=>{
    if (!v) return;
    const dt = document.createElement("dt"); dt.textContent = I18N[lang]["review."+k] || k;
    const dd = document.createElement("dd"); dd.textContent = v;
    const row = document.createElement("div"); row.className = "review-item";
    row.appendChild(dt); row.appendChild(dd);
    list.appendChild(row);
  });
}

function collectData(){
  const form = document.getElementById("onboardForm");
  const fd = new FormData(form);
  const data = {};
  fd.forEach((v,k)=> data[k]=v.toString().trim());
  return data;
}

btnNext.addEventListener("click", async ()=>{
  if (currentStep <= TOTAL_STEPS){
    if (!validateStep(currentStep)) return;
  }
  if (currentStep < TOTAL_STEPS){
    currentStep++;
    if (currentStep === TOTAL_STEPS) buildReview();
    showStep(currentStep);
    return;
  }
  if (currentStep === TOTAL_STEPS){
    await submitForm();
  }
});

btnBack.addEventListener("click", ()=>{
  if (currentStep > 1){ currentStep--; showStep(currentStep); }
});

async function submitForm(){
  const data = collectData();
  data.idioma = data.idioma_padrao;
  btnNext.disabled = true; btnNext.textContent = I18N[lang]["nav.sending"];
  document.getElementById("fatalMsg").classList.remove("show");
  try{
    const res = await fetch("REPLACE_WITH_N8N_WEBHOOK_URL", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(data)
    });
    if (!res.ok) throw new Error("bad status");
    showStep("success");
  }catch(e){
    document.getElementById("fatalMsg").classList.add("show");
    btnNext.disabled = false;
    updateNavLabels();
  }
}

showStep(1);
applyI18n();
</script>
</body>
