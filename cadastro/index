    "s4.sub":"Our team will reach out to finish activating your AI Employee.",
    "s4.nome.label":"Your name","s4.nome.ph":"Your full name",
    "s4.contato.label":"Phone or email","s4.contato.ph":"e.g. +353 83 363 8205",
