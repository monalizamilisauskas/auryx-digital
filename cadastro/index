    "s5.eyebrow":"05 — Revisão","s5.title":"Tudo certo?",
    "s5.sub":"Confira antes de enviar. Você ainda pode voltar e ajustar qualquer campo.",
    "success.title":"Recebemos seu cadastro",
    "success.sub":"Nossa equipe vai finalizar a configuração e entrar em contato em breve para ativar seu AI Employee.",
    "nav.back":"Voltar","nav.next":"Continuar","nav.submit":"Enviar cadastro","nav.sending":"Enviando...",
    "err.required":"Preencha este campo para continuar.",
    "err.fatal":"Não foi possível enviar seu cadastro agora. Tente novamente em instantes.",
    "step.1":"Sobre o negócio","step.2":"Perguntas frequentes","step.3":"Preferências","step.4":"Contato","step.5":"Revisão",
    "review.nome_negocio":"Negócio","review.tipo_negocio":"Tipo","review.servicos_oferecidos":"Serviços",
    "review.faq_horario":"Horário","review.faq_area":"Área","review.faq_pagamento":"Pagamento","review.faq_adicional":"Extra",
    "review.idioma_padrao":"Idioma","review.timezone":"Fuso","review.contato_nome":"Nome","review.contato_responsavel":"Contato"
  },
  en: {
    "progress.of": s => `Step ${s} of 5`,
    "s1.eyebrow":"01 — Your business","s1.title":"Tell us about your business",
    "s1.sub":"This shapes how your AI introduces itself to your customers.",
    "s1.nome.label":"Business name","s1.nome.ph":"e.g. Silva Electric",
    "s1.tipo.label":"Business type","s1.tipo.placeholder":"Select...",
    "s1.servicos.label":"What services do you offer?","s1.servicos.ph":"e.g. wiring, maintenance, 24h emergencies",
    "s1.servicos.help":"Your AI uses this list to answer what the business does.",
    "tipo.eletricista":"Electrician","tipo.encanador":"Plumber","tipo.dentista":"Dental clinic",
    "tipo.salao":"Hair & beauty salon","tipo.clinica":"Clinic / practice","tipo.restaurante":"Restaurant","tipo.outro":"Other",
    "s2.eyebrow":"02 — Frequent questions","s2.title":"What do customers always ask?",
    "s2.sub":"Your AI answers strictly from what you write here — it never makes anything up.",
    "s2.horario.label":"What are your opening hours?","s2.horario.ph":"e.g. Mon–Fri, 8am to 6pm",
    "s2.area.label":"What area do you cover?","s2.area.ph":"e.g. Greater Dublin",
    "s2.pagamento.label":"What payment methods do you accept?","s2.pagamento.ph":"e.g. cash, card, bank transfer",
    "s2.adicional.label":"Anything else customers usually ask?","s2.adicional.optional":"(optional)",
    "s2.adicional.ph":"e.g. warranty on the work",
    "s3.eyebrow":"03 — Preferences","s3.title":"How your AI should speak",
    "s3.sub":"We tailor the language and time zone for every conversation and booking.",
    "s3.idioma.label":"Default language","s3.idioma.pt":"Português","s3.idioma.en":"English",
    "s3.timezone.label":"Time zone",
