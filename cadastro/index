<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Auryx — Cadastro do seu AI Employee</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#000000;
    --panel:#0A0A0A;
    --panel-2:#141414;
    --line: rgba(201,162,39,0.16);
    --gold:#C9A227;
    --gold-bright:#E8C767;
    --parchment:#F4EFE0;
    --muted:#948C77;
    --error:#D9765C;
    --radius: 3px;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:
      radial-gradient(1200px 600px at 15% -10%, rgba(201,162,39,0.10), transparent 60%),
      radial-gradient(900px 500px at 110% 10%, rgba(201,162,39,0.06), transparent 55%),
      var(--ink);
    color:var(--parchment);
    font-family:'Inter', sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
    display:flex;
    flex-direction:column;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }

  /* ---------- Top bar ---------- */
  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding:28px clamp(20px,5vw,64px) 0;
  }
  .brand{
    display:flex; align-items:center;
  }
  .brand-mark{height:52px;width:auto;flex-shrink:0;display:block;}
  .langtoggle{
    display:flex; border:1px solid var(--line); border-radius:20px; overflow:hidden;
    font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.06em;
  }
  .langtoggle button{
    background:transparent; border:none; color:var(--muted); padding:7px 14px; cursor:pointer;
    transition:.2s;
  }
  .langtoggle button.active{ background:var(--gold); color:#1a1608; font-weight:500;}

  /* ---------- Progress (signature wing element) ---------- */
  .progress-wrap{
    padding: 30px clamp(20px,5vw,64px) 0;
    max-width:640px; margin:0 auto; width:100%;
  }
  .progress-label{
    display:flex; justify-content:space-between; align-items:baseline;
    font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:0.08em;
    color:var(--muted); margin-bottom:10px; text-transform:uppercase;
  }
  .progress-label .step-name{color:var(--gold-bright);}
  .wing{
    position:relative; height:14px; width:100%;
    clip-path: polygon(0 45%, 6% 100%, 12% 45%, 18% 100%, 24% 45%, 30% 100%, 36% 45%, 42% 100%, 48% 45%, 54% 100%, 60% 45%, 66% 100%, 72% 45%, 78% 100%, 84% 45%, 90% 100%, 96% 45%, 100% 65%, 100% 0, 0 0);
    background:rgba(201,162,39,0.14);
  }
  .wing-fill{
    height:100%; width:0%;
    background:linear-gradient(90deg, var(--gold), var(--gold-bright));
    transition: width .55s cubic-bezier(.65,0,.35,1);
  }

  /* ---------- Main stage ---------- */
  main{
    flex:1; display:flex; align-items:center; justify-content:center;
    padding: 30px clamp(20px,5vw,64px) 60px;
  }
  .stage{ max-width:640px; width:100%; }

  .step{ display:none; animation: rise .5s cubic-bezier(.22,1,.36,1); }
  .step.active{ display:block; }
  @keyframes rise{ from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:none;} }

  .eyebrow{
    font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.14em;
    color:var(--gold); text-transform:uppercase; margin:0 0 14px;
  }
  h1{
    font-family:'Fraunces', serif; font-weight:500; font-size:clamp(26px,4vw,38px);
    line-height:1.15; margin:0 0 10px; color:var(--parchment);
  }
  .sub{ color:var(--muted); font-size:15.5px; line-height:1.6; margin:0 0 34px; max-width:52ch;}

  .field{ margin-bottom:22px; }
  .field label{
    display:block; font-size:13.5px; font-weight:500; color:var(--parchment);
    margin-bottom:8px;
  }
  .help{ font-size:12.5px; color:var(--muted); margin-top:6px; line-height:1.5; }
  input[type=text], input[type=tel], input[type=email], textarea, select{
    width:100%; background:var(--panel); border:1px solid var(--line); color:var(--parchment);
    border-radius:var(--radius); padding:13px 14px; font-size:15px; font-family:'Inter',sans-serif;
    transition:.2s border-color, .2s background;
  }
  textarea{ min-height:88px; resize:vertical; }
  input:focus, textarea:focus, select:focus{
    outline:none; border-color:var(--gold); background:var(--panel-2);
  }
  select{ appearance:none; background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="12" height="8"><path d="M1 1l5 5 5-5" stroke="%23C9A227" stroke-width="1.6" fill="none"/></svg>'); background-repeat:no-repeat; background-position:right 14px center; padding-right:36px;}
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:560px){ .grid2{grid-template-columns:1fr;} }
  .err{ color:var(--error); font-size:12.5px; margin-top:6px; display:none; }
  .field.invalid input, .field.invalid textarea, .field.invalid select{ border-color:var(--error); }
  .field.invalid .err{ display:block; }

  /* ---------- Nav buttons ---------- */
  .nav{ display:flex; justify-content:space-between; align-items:center; margin-top:36px; }
  .btn{
    font-family:'Inter', sans-serif; font-weight:600; font-size:14.5px; letter-spacing:0.01em;
    padding:13px 26px; border-radius:24px; cursor:pointer; border:1px solid transparent;
    transition:.2s transform, .2s background, .2s box-shadow;
  }
  .btn:active{ transform:scale(0.97); }
  .btn-primary{
    background:linear-gradient(180deg, var(--gold-bright), var(--gold));
    color:#1a1608; box-shadow:0 8px 24px -8px rgba(201,162,39,0.55);
  }
  .btn-primary:hover{ box-shadow:0 10px 28px -6px rgba(201,162,39,0.7); }
  .btn-ghost{ background:transparent; color:var(--muted); border-color:var(--line); }
  .btn-ghost:hover{ color:var(--parchment); border-color:var(--gold); }
  .btn:disabled{ opacity:.45; cursor:not-allowed; box-shadow:none; }

  /* ---------- Review step ---------- */
  .review-item{
    display:flex; justify-content:space-between; gap:20px; padding:14px 0;
    border-bottom:1px solid var(--line); font-size:14.5px;
  }
  .review-item dt{ color:var(--muted); flex-shrink:0; }
  .review-item dd{ margin:0; text-align:right; color:var(--parchment); }

  /* ---------- Success ---------- */
  .success{ text-align:center; }
  .success-logo{ width:220px; height:auto; margin:0 auto 30px; display:block; filter:drop-shadow(0 10px 30px rgba(201,162,39,0.4)); animation: logoRise .7s cubic-bezier(.22,1,.36,1); }
  @keyframes logoRise{ from{opacity:0; transform:translateY(10px) scale(.96);} to{opacity:1; transform:none;} }
  .success .sub{ margin:0 auto; }

  .fatal{ display:none; }
  .fatal.show{ display:block; color:var(--error); font-size:13.5px; margin-top:16px; }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">
    <img src="data:image/png;base64," alt="Auryx" class="brand-mark">
  </div>
  <div class="langtoggle">
    <button type="button" class="active" data-lang="pt">PT</button>
    <button type="button" data-lang="en">EN</button>
  </div>
</div>

<div class="progress-wrap">
  <div class="progress-label">
    <span data-i18n="progress.of">Etapa <span id="stepNum">1</span> de 5</span>
    <span class="step-name" id="stepName">Sobre o negócio</span>
  </div>
  <div class="wing"><div class="wing-fill" id="wingFill"></div></div>
</div>

<main>
  <form class="stage" id="onboardForm" novalidate>

    <!-- STEP 1 -->
    <section class="step active" data-step="1">
      <p class="eyebrow" data-i18n="s1.eyebrow">01 — O negócio</p>
      <h1 data-i18n="s1.title">Vamos conhecer o seu negócio</h1>
      <p class="sub" data-i18n="s1.sub">Essas informações moldam como sua IA vai se apresentar aos seus clientes.</p>

      <div class="field" data-field="nome_negocio">
        <label data-i18n="s1.nome.label">Nome do negócio</label>
        <input type="text" name="nome_negocio" placeholder="Ex: Elétrica Silva" data-i18n-ph="s1.nome.ph">
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>

      <div class="field" data-field="tipo_negocio">
        <label data-i18n="s1.tipo.label">Tipo de negócio</label>
        <select name="tipo_negocio">
          <option value="" data-i18n="s1.tipo.placeholder">Selecione...</option>
          <option value="eletricista" data-i18n="tipo.eletricista">Eletricista</option>
          <option value="encanador" data-i18n="tipo.encanador">Encanador</option>
          <option value="clinica_odontologica" data-i18n="tipo.dentista">Clínica odontológica</option>
          <option value="salao" data-i18n="tipo.salao">Salão de beleza</option>
          <option value="clinica" data-i18n="tipo.clinica">Clínica / consultório</option>
          <option value="restaurante" data-i18n="tipo.restaurante">Restaurante</option>
          <option value="outro" data-i18n="tipo.outro">Outro</option>
        </select>
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>

      <div class="field" data-field="servicos_oferecidos">
        <label data-i18n="s1.servicos.label">Quais serviços vocês oferecem?</label>
        <textarea name="servicos_oferecidos" placeholder="" data-i18n-ph="s1.servicos.ph"></textarea>
        <p class="help" data-i18n="s1.servicos.help">Sua IA vai usar essa lista para responder o que o negócio faz.</p>
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>
    </section>

    <!-- STEP 2 -->
    <section class="step" data-step="2">
      <p class="eyebrow" data-i18n="s2.eyebrow">02 — Perguntas frequentes</p>
      <h1 data-i18n="s2.title">O que seus clientes sempre perguntam?</h1>
      <p class="sub" data-i18n="s2.sub">Sua IA vai responder exatamente com base no que você disser aqui — nunca inventa uma resposta.</p>

      <div class="field" data-field="faq_horario">
        <label data-i18n="s2.horario.label">Qual o horário de funcionamento?</label>
        <input type="text" name="faq_horario" data-i18n-ph="s2.horario.ph">
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>
      <div class="field" data-field="faq_area">
        <label data-i18n="s2.area.label">Qual área vocês atendem?</label>
        <input type="text" name="faq_area" data-i18n-ph="s2.area.ph">
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>
      <div class="field" data-field="faq_pagamento">
        <label data-i18n="s2.pagamento.label">Quais formas de pagamento vocês aceitam?</label>
        <input type="text" name="faq_pagamento" data-i18n-ph="s2.pagamento.ph">
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>
      <div class="field" data-field="faq_adicional">
        <label data-i18n="s2.adicional.label">Mais alguma coisa que seus clientes costumam perguntar? <span style="color:var(--muted); font-weight:400;" data-i18n="s2.adicional.optional">(opcional)</span></label>
        <input type="text" name="faq_adicional" data-i18n-ph="s2.adicional.ph">
      </div>
    </section>

    <!-- STEP 3 -->
    <section class="step" data-step="3">
      <p class="eyebrow" data-i18n="s3.eyebrow">03 — Preferências</p>
      <h1 data-i18n="s3.title">Como sua IA deve falar</h1>
      <p class="sub" data-i18n="s3.sub">Ajustamos o idioma e o fuso horário para cada conversa e cada agendamento.</p>

      <div class="grid2">
        <div class="field" data-field="idioma_padrao">
          <label data-i18n="s3.idioma.label">Idioma padrão</label>
          <select name="idioma_padrao">
            <option value="pt" data-i18n="s3.idioma.pt">Português</option>
            <option value="en" data-i18n="s3.idioma.en">English</option>
          </select>
        </div>
        <div class="field" data-field="timezone">
          <label data-i18n="s3.timezone.label">Fuso horário</label>
          <select name="timezone">
            <option value="Europe/Dublin">Europe/Dublin</option>
            <option value="America/Sao_Paulo">America/Sao_Paulo</option>
            <option value="America/New_York">America/New_York</option>
            <option value="Europe/Lisbon">Europe/Lisbon</option>
          </select>
        </div>
      </div>
    </section>

    <!-- STEP 4 -->
    <section class="step" data-step="4">
      <p class="eyebrow" data-i18n="s4.eyebrow">04 — Contato</p>
      <h1 data-i18n="s4.title">Quem devemos contatar?</h1>
      <p class="sub" data-i18n="s4.sub">Nossa equipe entra em contato para finalizar a ativação do seu AI Employee.</p>

      <div class="field" data-field="contato_nome">
        <label data-i18n="s4.nome.label">Seu nome</label>
        <input type="text" name="contato_nome" data-i18n-ph="s4.nome.ph">
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>
      <div class="field" data-field="contato_responsavel">
        <label data-i18n="s4.contato.label">Telefone ou e-mail</label>
        <input type="text" name="contato_responsavel" data-i18n-ph="s4.contato.ph">
        <p class="err" data-i18n="err.required">Preencha este campo para continuar.</p>
      </div>
    </section>

    <!-- STEP 5: REVIEW -->
    <section class="step" data-step="5">
      <p class="eyebrow" data-i18n="s5.eyebrow">05 — Revisão</p>
      <h1 data-i18n="s5.title">Tudo certo?</h1>
      <p class="sub" data-i18n="s5.sub">Confira antes de enviar. Você ainda pode voltar e ajustar qualquer campo.</p>
      <dl id="reviewList"></dl>
      <p class="fatal" id="fatalMsg" data-i18n="err.fatal">Não foi possível enviar seu cadastro agora. Tente novamente em instantes.</p>
    </section>

    <!-- SUCCESS -->
    <section class="step" data-step="success">
      <div class="success">
        <img src="data:image/png;base64," alt="Auryx" class="success-logo">
        <h1 data-i18n="success.title">Recebemos seu cadastro</h1>
        <p class="sub" data-i18n="success.sub">Nossa equipe vai finalizar a configuração e entrar em contato em breve para ativar seu AI Employee.</p>
      </div>
    </section>

    <div class="nav" id="navRow">
      <button type="button" class="btn btn-ghost" id="btnBack" data-i18n="nav.back">Voltar</button>
      <button type="button" class="btn btn-primary" id="btnNext" data-i18n="nav.next">Continuar</button>
    </div>
  </form>
</main>

<script>
/* ---------------- i18n ---------------- */
const I18N = {
  pt: {
    "progress.of": s => `Etapa ${s} de 5`,
    "s1.eyebrow":"01 — O negócio","s1.title":"Vamos conhecer o seu negócio",
    "s1.sub":"Essas informações moldam como sua IA vai se apresentar aos seus clientes.",
    "s1.nome.label":"Nome do negócio","s1.nome.ph":"Ex: Elétrica Silva",
    "s1.tipo.label":"Tipo de negócio","s1.tipo.placeholder":"Selecione...",
    "s1.servicos.label":"Quais serviços vocês oferecem?","s1.servicos.ph":"Ex: instalação elétrica, manutenção, emergências 24h",
    "s1.servicos.help":"Sua IA vai usar essa lista para responder o que o negócio faz.",
    "tipo.eletricista":"Eletricista","tipo.encanador":"Encanador","tipo.dentista":"Clínica odontológica",
    "tipo.salao":"Salão de beleza","tipo.clinica":"Clínica / consultório","tipo.restaurante":"Restaurante","tipo.outro":"Outro",
    "s2.eyebrow":"02 — Perguntas frequentes","s2.title":"O que seus clientes sempre perguntam?",
    "s2.sub":"Sua IA vai responder exatamente com base no que você disser aqui — nunca inventa uma resposta.",
    "s2.horario.label":"Qual o horário de funcionamento?","s2.horario.ph":"Ex: Segunda a sexta, 8h às 18h",
    "s2.area.label":"Qual área vocês atendem?","s2.area.ph":"Ex: Grande Dublin",
    "s2.pagamento.label":"Quais formas de pagamento vocês aceitam?","s2.pagamento.ph":"Ex: dinheiro, cartão, transferência",
    "s2.adicional.label":"Mais alguma coisa que seus clientes costumam perguntar?","s2.adicional.optional":"(opcional)",
    "s2.adicional.ph":"Ex: garantia do serviço",
    "s3.eyebrow":"03 — Preferências","s3.title":"Como sua IA deve falar",
    "s3.sub":"Ajustamos o idioma e o fuso horário para cada conversa e cada agendamento.",
    "s3.idioma.label":"Idioma padrão","s3.idioma.pt":"Português","s3.idioma.en":"English",
    "s3.timezone.label":"Fuso horário",
